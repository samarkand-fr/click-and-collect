{
  "name": "@cnc/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microservice notifications : consommation order.status_updated (RabbitMQ) et diffusion temps réel Socket.io — rooms kitchen (écran cuisine) et order_<id> (suivi client)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "publish:test": "tsx scripts/publish-status-update.ts",
    "client:test": "tsx scripts/test-socket-client.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
