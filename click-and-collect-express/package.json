{
  "name": "click-and-collect-express",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "gateway",
    "services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "ps": "docker compose ps",
    "infra:up": "docker compose up -d rabbitmq catalog-db orders-db payment-db notifications-db",
    "infra:down": "docker compose down",
    "clean": "docker compose down -v",
    "prisma:generate": "npm run prisma:generate -w @cnc/catalog-service && npm run prisma:generate -w @cnc/order-service",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
