{
  "name": "@cnc/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway Click & Collect Express : point d'entrée HTTP/WS unique (proxy REST, WebSocket /socket.io, CORS, rate-limiting, erreurs JSON homogènes)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "http-proxy-middleware": "^3.0.5",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
